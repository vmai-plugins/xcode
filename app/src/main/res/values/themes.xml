<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all in-app theming; this exists only so the window has a
         sensible background before the first frame, avoiding a white flash on a
         dark-themed launch. -->
    <style name="Theme.VMStudioCode" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
